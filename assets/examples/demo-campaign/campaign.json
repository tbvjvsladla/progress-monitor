      "expect": "GREET-OK",
      "inputs": [
        "greet"
      ],
      "env": [],
      "covers": []
    },
    {
      "id": "count-check",
      "cmd": "test \"$(cat count/value.txt)\" = 2 && echo COUNT-OK",
      "cwd": ".",
      "expect": "COUNT-OK",
      "inputs": [
        "count"
      ],
      "env": [],
      "covers": []
    },
    {
      "id": "all",
      "cmd": "grep -qx 'hello, campaign' greet/message.txt && test \"$(cat count/value.txt)\" = 2 && echo ALL-OK",
      "cwd": ".",
      "expect": "ALL-OK",
      "inputs": [
        "greet",
        "count"
      ],
      "env": [],
      "covers": [
        "greet-check",
        "count-check"
      ]
    }
  ],
  "groups": [
    {
      "group": "g-demo",
      "checks": [
